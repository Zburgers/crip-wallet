{
  "name": "crip-wallet",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Provider-neutral agent-wallet authorization control plane",
  "engines": {
    "node": ">=24 <27",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.17.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "adapters/*"
  ],
  "scripts": {
    "check": "npm run check:static && npm run test:unit && npm run docs:check && npm run repo:check",
    "check:static": "npm run format:check && npm run lint && npm run typecheck",
    "docs:check": "node tooling/docs-check.mjs",
    "repo:check": "node tooling/repo-check.mjs",
    "format:check": "prettier --check \"**/*.{js,mjs,cjs,ts,tsx,json,yml,yaml,css}\"",
    "format:write": "prettier --write \"**/*.{js,mjs,cjs,ts,tsx,json,yml,yaml,css}\"",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "pretest:unit": "npm run build --workspaces --if-present",
    "test:unit": "node --test tests/repository/*.test.mjs && vitest run packages --passWithNoTests",
    "pretest:db": "npm run build --workspaces --if-present",
    "test:db": "node tooling/phase1-test-gate.mjs db",
    "pretest:concurrency": "npm run build --workspaces --if-present",
    "test:concurrency": "node tooling/phase1-test-gate.mjs concurrency",
    "pretest:invariants": "npm run build --workspaces --if-present",
    "test:invariants": "node tooling/phase1-test-gate.mjs invariants",
    "contracts:test": "node tooling/phase2-contracts.mjs",
    "dev:up": "bash scripts/dev-up.sh",
    "dev:status": "bash scripts/dev-status.sh",
    "dev:down": "bash scripts/dev-down.sh"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.2.0",
    "eslint": "10.8.1",
    "fast-check": "4.9.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10",
    "@types/pg": "8.21.0"
  }
}
